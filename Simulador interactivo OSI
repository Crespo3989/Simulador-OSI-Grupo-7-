class SimuladorOSI(tk.Tk):
    """Ventana principal del simulador."""

    BG = "#081120"
    PANEL = "#101c30"
    PANEL_2 = "#16243b"
    TEXT = "#edf4ff"
    MUTED = "#9fb0c7"
    ACCENT = "#28c7fa"

    def __init__(self):
        super().__init__()
        self.title("Simulador interactivo — Modelo OSI")
        self.geometry("1280x800")
        self.minsize(1080, 700)
        self.configure(bg=self.BG)

        self.modo = "encapsular"
        self.indice = -1
        self.ejecutando = False
        self.after_id = None
        self.historial = []
        self.tarjetas = []
        self._configurar_estilos()
        self._crear_interfaz()
        self._seleccionar_modo("encapsular")

    def _configurar_estilos(self):
        estilo = ttk.Style(self)
        estilo.theme_use("clam")
        estilo.configure(
            "OSI.Horizontal.TProgressbar",
            troughcolor="#22314a",
            background=self.ACCENT,
            bordercolor="#22314a",
            lightcolor=self.ACCENT,
            darkcolor=self.ACCENT,
        )

    def _crear_interfaz(self):
        cabecera = tk.Frame(self, bg=self.BG)
        cabecera.pack(fill="x", padx=28, pady=(20, 12))
        tk.Label(
            cabecera,
            text="MODELO OSI",
            font=("Segoe UI", 10, "bold"),
            fg=self.ACCENT,
            bg=self.BG,
        ).pack(anchor="w")
        tk.Label(
            cabecera,
            text="Simulador de encapsulamiento de datos",
            font=("Segoe UI", 25, "bold"),
            fg=self.TEXT,
            bg=self.BG,
        ).pack(anchor="w")
        tk.Label(
            cabecera,
            text="Observa cómo cambia la unidad de datos al atravesar cada capa.",
            font=("Segoe UI", 11),
            fg=self.MUTED,
            bg=self.BG,
        ).pack(anchor="w", pady=(3, 0))

        cuerpo = tk.Frame(self, bg=self.BG)
        cuerpo.pack(fill="both", expand=True, padx=28, pady=(0, 24))
        cuerpo.grid_columnconfigure(0, weight=5)
        cuerpo.grid_columnconfigure(1, weight=6)
        cuerpo.grid_rowconfigure(0, weight=1)

        self._crear_panel_capas(cuerpo)
        self._crear_panel_control(cuerpo)

    def _crear_panel_capas(self, padre):
        panel = tk.Frame(padre, bg=self.PANEL, highlightthickness=1, highlightbackground="#253652")
        panel.grid(row=0, column=0, sticky="nsew", padx=(0, 9))

        superior = tk.Frame(panel, bg=self.PANEL)
        superior.pack(fill="x", padx=18, pady=(16, 10))
        tk.Label(superior, text="RECORRIDO DE LOS DATOS", font=("Segoe UI", 11, "bold"),
                 fg=self.TEXT, bg=self.PANEL).pack(side="left")
        self.lbl_direccion = tk.Label(superior, font=("Segoe UI", 10, "bold"),
                                      fg=self.ACCENT, bg=self.PANEL)
        self.lbl_direccion.pack(side="right")

        contenedor = tk.Frame(panel, bg=self.PANEL)
        contenedor.pack(fill="both", expand=True, padx=16, pady=(0, 16))
        for capa in CAPAS:
            tarjeta = tk.Frame(contenedor, bg=self.PANEL_2, highlightthickness=1,
                               highlightbackground="#263955", cursor="hand2")
            tarjeta.pack(fill="both", expand=True, pady=3)
            banda = tk.Frame(tarjeta, bg=capa["color"], width=7)
            banda.pack(side="left", fill="y")
            num = tk.Label(tarjeta, text=str(capa["numero"]), font=("Segoe UI", 14, "bold"),
                           width=3, fg=capa["color"], bg=self.PANEL_2)
            num.pack(side="left", padx=(8, 2))
            bloque = tk.Frame(tarjeta, bg=self.PANEL_2)
            bloque.pack(side="left", fill="both", expand=True, pady=7)
            nombre = tk.Label(bloque, text=capa["nombre"], font=("Segoe UI", 11, "bold"),
                              fg=self.TEXT, bg=self.PANEL_2)
            nombre.pack(anchor="w")
            proto = tk.Label(bloque, text=capa["protocolos"], font=("Segoe UI", 8),
                             fg=self.MUTED, bg=self.PANEL_2)
            proto.pack(anchor="w")
            pdu = tk.Label(tarjeta, text=capa["pdu"], font=("Segoe UI", 9, "bold"),
                           fg="#dce7f7", bg="#23334e", padx=10, pady=4)
            pdu.pack(side="right", padx=10)
            elementos = [tarjeta, num, bloque, nombre, proto, pdu]
            for elemento in elementos:
                elemento.bind("<Button-1>", lambda _e, c=capa: self._mostrar_capa(c))
            self.tarjetas.append((tarjeta, banda, num, bloque, nombre, proto, pdu))

    def _crear_panel_control(self, padre):
        panel = tk.Frame(padre, bg=self.PANEL, highlightthickness=1, highlightbackground="#253652")
        panel.grid(row=0, column=1, sticky="nsew", padx=(9, 0))

        modos = tk.Frame(panel, bg=self.PANEL)
        modos.pack(fill="x", padx=20, pady=(18, 12))
        self.btn_enc = self._boton(modos, "↓  ENCAPSULAR", lambda: self._seleccionar_modo("encapsular"))
        self.btn_enc.pack(side="left", fill="x", expand=True, padx=(0, 5))
        self.btn_dec = self._boton(modos, "↑  DESENCAPSULAR", lambda: self._seleccionar_modo("desencapsular"))
        self.btn_dec.pack(side="left", fill="x", expand=True, padx=(5, 0))

        entrada = tk.Frame(panel, bg=self.PANEL_2, highlightthickness=1, highlightbackground="#2a3d5b")
        entrada.pack(fill="x", padx=20, pady=(0, 12))
        tk.Label(entrada, text="MENSAJE A TRANSMITIR", font=("Segoe UI", 9, "bold"),
                 fg=self.MUTED, bg=self.PANEL_2).pack(anchor="w", padx=14, pady=(10, 4))
        self.txt_mensaje = tk.Entry(entrada, font=("Consolas", 12), fg=self.TEXT, bg="#0c1728",
                                    insertbackground=self.TEXT, relief="flat")
        self.txt_mensaje.pack(fill="x", padx=14, ipady=8, pady=(0, 12))
        self.txt_mensaje.insert(0, "Hola, modelo OSI")

        controles = tk.Frame(panel, bg=self.PANEL)
        controles.pack(fill="x", padx=20, pady=(0, 10))
        self.btn_iniciar = self._boton(controles, "▶  Ejecutar", self.iniciar, self.ACCENT, "#06121d")
        self.btn_iniciar.pack(side="left", padx=(0, 6))
        self.btn_paso = self._boton(controles, "Paso siguiente", self.paso_siguiente)
        self.btn_paso.pack(side="left", padx=6)
        self.btn_reiniciar = self._boton(controles, "↻  Reiniciar", self.reiniciar)
        self.btn_reiniciar.pack(side="right", padx=(6, 0))

        self.progreso = ttk.Progressbar(panel, style="OSI.Horizontal.TProgressbar", maximum=7)
        self.progreso.pack(fill="x", padx=20, pady=(2, 12))

        detalle = tk.Frame(panel, bg="#0c1728", highlightthickness=1, highlightbackground="#2a3d5b")
        detalle.pack(fill="both", expand=True, padx=20, pady=(0, 18))
        self.lbl_estado = tk.Label(detalle, text="LISTO PARA COMENZAR", font=("Segoe UI", 9, "bold"),
                                   fg=self.ACCENT, bg="#0c1728")
        self.lbl_estado.pack(anchor="w", padx=16, pady=(14, 2))
        self.lbl_titulo = tk.Label(detalle, text="Selecciona un modo", font=("Segoe UI", 18, "bold"),
                                   fg=self.TEXT, bg="#0c1728")
        self.lbl_titulo.pack(anchor="w", padx=16)
        self.lbl_explicacion = tk.Label(detalle, text="", font=("Segoe UI", 10), justify="left",
                                        wraplength=590, fg=self.MUTED, bg="#0c1728")
        self.lbl_explicacion.pack(anchor="w", padx=16, pady=(5, 12))

        tk.Label(detalle, text="UNIDAD DE DATOS (PDU)", font=("Segoe UI", 8, "bold"),
                 fg=self.MUTED, bg="#0c1728").pack(anchor="w", padx=16)
        self.lbl_pdu = tk.Label(detalle, text="Datos", font=("Consolas", 10, "bold"), justify="left",
                                wraplength=590, fg="#d9f5ff", bg="#14243b", padx=12, pady=10)
        self.lbl_pdu.pack(fill="x", padx=16, pady=(4, 10))

        tk.Label(detalle, text="REGISTRO DE LA SIMULACIÓN", font=("Segoe UI", 8, "bold"),
                 fg=self.MUTED, bg="#0c1728").pack(anchor="w", padx=16)
        self.txt_log = tk.Text(detalle, height=5, font=("Consolas", 9), fg="#bcd0e8",
                               bg="#091321", relief="flat", state="disabled", padx=8, pady=7)
        self.txt_log.pack(fill="both", expand=True, padx=16, pady=(4, 14))

    def _boton(self, padre, texto, comando, fondo=None, frente=None):
        return tk.Button(
            padre, text=texto, command=comando, font=("Segoe UI", 9, "bold"),
            fg=frente or self.TEXT, bg=fondo or "#22334f", activeforeground=frente or self.TEXT,
            activebackground="#304869", relief="flat", cursor="hand2", padx=14, pady=9,
        )

    def _seleccionar_modo(self, modo):
        self.reiniciar(silencioso=True)
        self.modo = modo
        es_enc = modo == "encapsular"
        self.lbl_direccion.config(text="CAPA 7  →  CAPA 1" if es_enc else "CAPA 1  →  CAPA 7")
        self.btn_enc.config(bg=self.ACCENT if es_enc else "#22334f", fg="#06121d" if es_enc else self.TEXT)
        self.btn_dec.config(bg=self.ACCENT if not es_enc else "#22334f", fg="#06121d" if not es_enc else self.TEXT)
        self.lbl_titulo.config(text="Encapsulamiento" if es_enc else "Desencapsulamiento")
        self.lbl_explicacion.config(text=(
            "El emisor baja desde la capa de Aplicación hasta la Física. Cada capa añade información de control."
            if es_enc else
            "El receptor sube desde la capa Física hasta la Aplicación. Cada capa interpreta y retira su información de control."
        ))
        self._actualizar_pdu_inicial()

    def _actualizar_pdu_inicial(self):
        mensaje = self.txt_mensaje.get().strip() or "Hola, modelo OSI"
        if self.modo == "encapsular":
            self.lbl_pdu.config(text=f'Datos: "{mensaje}"')
        else:
            self.lbl_pdu.config(text=f"BITS → [MAC][IP][TCP][DATOS: {mensaje}][FCS]")

    def _orden(self):
        return CAPAS if self.modo == "encapsular" else list(reversed(CAPAS))

    def iniciar(self):
        if self.ejecutando:
            self.ejecutando = False
            if self.after_id:
                self.after_cancel(self.after_id)
                self.after_id = None
            self.btn_iniciar.config(text="▶  Continuar")
            return
        if self.indice >= 6:
            self.reiniciar(silencioso=True)
        self.ejecutando = True
        self.txt_mensaje.config(state="disabled")
        self.btn_iniciar.config(text="⏸  Pausar")
        self._animar()

    def _animar(self):
        if not self.ejecutando:
            return
        terminado = self.paso_siguiente(automatico=True)
        if not terminado:
            self.after_id = self.after(1350, self._animar)

    def paso_siguiente(self, automatico=False):
        if not automatico and self.ejecutando:
            self.iniciar()
        if self.indice >= 6:
            messagebox.showinfo("Simulación completa", "El recorrido por las 7 capas ha finalizado.")
            return True
        self.txt_mensaje.config(state="disabled")
        self.indice += 1
        capa = self._orden()[self.indice]
        self._activar_capa(capa)
        self._actualizar_detalle(capa)
        self.progreso["value"] = self.indice + 1
        self.update_idletasks()
        if self.indice == 6:
            self.ejecutando = False
            self.btn_iniciar.config(text="▶  Ejecutar de nuevo")
            self.lbl_estado.config(text="SIMULACIÓN COMPLETADA", fg="#06d6a0")
            return True
        return False

    def _activar_capa(self, capa):
        indice_visual = CAPAS.index(capa)
        for i, elementos in enumerate(self.tarjetas):
            fondo = capa["color"] if i == indice_visual else self.PANEL_2
            texto = "#07111e" if i == indice_visual else self.TEXT
            tarjeta, _banda, num, bloque, nombre, proto, pdu = elementos
            for widget in (tarjeta, num, bloque, nombre, proto):
                widget.config(bg=fondo)
            nombre.config(fg=texto)
            num.config(fg=texto if i == indice_visual else CAPAS[i]["color"])
            proto.config(fg="#152238" if i == indice_visual else self.MUTED)
            pdu.config(bg="#07111e" if i == indice_visual else "#23334e", fg="#ffffff")

    def _actualizar_detalle(self, capa):
        accion = capa["enc"] if self.modo == "encapsular" else capa["dec"]
        self.lbl_estado.config(text=f'PASO {self.indice + 1} DE 7  •  CAPA {capa["numero"]}', fg=capa["color"])
        self.lbl_titulo.config(text=f'{capa["numero"]}. {capa["nombre"]} — {capa["pdu"]}')
        self.lbl_explicacion.config(text=f'{accion}\n\nFunción: {capa["funcion"]}\nProtocolos/medios: {capa["protocolos"]}')
        pdu = self._construir_pdu(capa)
        self.lbl_pdu.config(text=pdu)
        simbolo = "+" if self.modo == "encapsular" else "−"
        self._agregar_log(f'{simbolo} Capa {capa["numero"]} {capa["nombre"]}: {accion}')

    def _construir_pdu(self, capa):
        mensaje = self.txt_mensaje.get().strip() or "Hola, modelo OSI"
        if self.modo == "encapsular":
            if capa["numero"] >= 5:
                return f'DATOS: "{mensaje}"'
            if capa["numero"] == 4:
                return f'[TCP | Puerto 5000→80] [DATOS: {mensaje}]'
            if capa["numero"] == 3:
                return f'[IP | 192.168.1.10→192.168.1.20] [TCP] [DATOS: {mensaje}]'
            if capa["numero"] == 2:
                return f'[MAC origen→destino] [IP] [TCP] [DATOS: {mensaje}] [FCS]'
            return self._a_bits(f'MAC|IP|TCP|{mensaje}|FCS')
        if capa["numero"] == 1:
            return self._a_bits(f'MAC|IP|TCP|{mensaje}|FCS')
        if capa["numero"] == 2:
            return f'[IP] [TCP] [DATOS: {mensaje}]  ← MAC y FCS retirados'
        if capa["numero"] == 3:
            return f'[TCP] [DATOS: {mensaje}]  ← cabecera IP retirada'
        if capa["numero"] == 4:
            return f'DATOS: "{mensaje}"  ← cabecera TCP retirada'
        return f'DATOS: "{mensaje}"'

    @staticmethod
    def _a_bits(texto):
        bits = " ".join(format(byte, "08b") for byte in texto.encode("utf-8")[:8])
        return f"BITS: {bits} …"

    def _agregar_log(self, texto):
        self.historial.append(texto)
        self.txt_log.config(state="normal")
        self.txt_log.insert("end", texto + "\n")
        self.txt_log.see("end")
        self.txt_log.config(state="disabled")

    def _mostrar_capa(self, capa):
        messagebox.showinfo(
            f'Capa {capa["numero"]}: {capa["nombre"]}',
            f'PDU: {capa["pdu"]}\n\nFunción:\n{capa["funcion"]}\n\n'
            f'Protocolos o medios:\n{capa["protocolos"]}\n\n'
            f'Encapsulamiento:\n{capa["enc"]}\n\nDesencapsulamiento:\n{capa["dec"]}',
        )

    def reiniciar(self, silencioso=False):
        self.ejecutando = False
        if self.after_id:
            self.after_cancel(self.after_id)
            self.after_id = None
        self.indice = -1
        self.historial.clear()
        if hasattr(self, "progreso"):
            self.progreso["value"] = 0
            self.txt_mensaje.config(state="normal")
            self.btn_iniciar.config(text="▶  Ejecutar")
            self.lbl_estado.config(text="LISTO PARA COMENZAR", fg=self.ACCENT)
            self.txt_log.config(state="normal")
            self.txt_log.delete("1.0", "end")
            self.txt_log.config(state="disabled")
            for i, elementos in enumerate(self.tarjetas):
                tarjeta, _banda, num, bloque, nombre, proto, pdu = elementos
                for widget in (tarjeta, num, bloque, nombre, proto):
                    widget.config(bg=self.PANEL_2)
                num.config(fg=CAPAS[i]["color"])
                nombre.config(fg=self.TEXT)
                proto.config(fg=self.MUTED)
                pdu.config(bg="#23334e", fg="#dce7f7")
            if not silencioso:
                self._seleccionar_modo(self.modo)


if __name__ == "__main__":
    app = SimuladorOSI()
    app.mainloop()
