    {
        "numero": 7,
        "nombre": "Aplicación",
        "pdu": "Datos",
        "color": "#ef476f",
        "funcion": "Proporciona servicios de red a las aplicaciones del usuario.",
        "protocolos": "HTTP, HTTPS, FTP, SMTP, DNS",
        "enc": "Genera los datos que se enviarán por la red.",
        "dec": "Entrega el mensaje final a la aplicación receptora.",
    },
    {
        "numero": 6,
        "nombre": "Presentación",
        "pdu": "Datos",
        "color": "#f78c6b",
        "funcion": "Traduce, comprime y cifra la información.",
        "protocolos": "TLS/SSL, JPEG, ASCII, UTF-8",
        "enc": "Codifica, comprime o cifra los datos.",
        "dec": "Descifra, descomprime y traduce los datos.",
