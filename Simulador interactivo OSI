        "funcion": "Establece, mantiene y finaliza sesiones de comunicación.",
        "protocolos": "NetBIOS, RPC, SIP",
        "enc": "Abre y sincroniza la sesión entre los equipos.",
        "dec": "Verifica la sesión y la mantiene o la cierra.",
    },
    {
        "numero": 4,
        "nombre": "Transporte",
        "pdu": "Segmento",
        "color": "#06d6a0",
        "funcion": "Segmenta datos y controla la entrega extremo a extremo.",
        "protocolos": "TCP, UDP",
        "enc": "Añade puertos, control y número de secuencia (cabecera TCP/UDP).",
